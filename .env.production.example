# ─────────────────────────────────────────────────────────────
# Variables de producción. Copiar a .env.production y completar.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Este archivo cumple dos funciones: lo lee el compose para interpolar los
# servicios Y se lo pasa entero al backend como env_file. Por eso conviven acá
# las credenciales de infraestructura y las de la aplicación.
#
# .env.production NO se commitea. Está en .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Plataforma ───────────────────────────────────────────────
# Sin protocolo ni www. De acá salen el portal, los subdominios de cada
# inmobiliaria y el host del CDN.
#
# También se compila dentro del bundle del frontend (build arg
# VITE_PLATFORM_DOMAIN, ver docker-compose.prod.yml): es con lo que la SPA
# distingue el portal de la web de una inmobiliaria. Cambiarlo obliga a
# reconstruir la imagen del frontend, no alcanza con reiniciar.
PLATFORM_DOMAIN=plataforma.com

# Adónde tiene que apuntar el DNS de un dominio propio. Normalmente el mismo
# dominio de la plataforma, que ya resuelve a la IP del VPS.
CUSTOM_DOMAIN_TARGET=plataforma.com

# En producción SIEMPRE node: "fake" da por verificado cualquier dominio, o sea
# que cualquiera podría reclamar el dominio de un tercero.
DNS_RESOLVER=node

# Dirección a la que Let's Encrypt avisa si un certificado no se puede renovar.
ACME_EMAIL=admin@plataforma.com

# Token que Caddy le manda al backend antes de emitir un certificado.
# Generar uno propio:  openssl rand -hex 32
# Sin esto, cualquiera que apunte un dominio a este VPS hace emitir certificados
# a tu nombre y agota la cuota semanal de Let's Encrypt.
CADDY_ASK_TOKEN=cambiame-openssl-rand-hex-32

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Origen del portal. Con la API servida en /api del mismo host, CORS casi no
# entra en juego, pero el backend igual lo usa para armar los enlaces de los
# correos.
FRONTEND_URL=https://plataforma.com

# URL pública del backend. MercadoPago la usa como notification_url del
# webhook: tiene que llegar desde internet.
BACKEND_URL=https://plataforma.com

# ── Postgres ─────────────────────────────────────────────────
# Estas tres las consume el contenedor de la base.
POSTGRES_USER=app
POSTGRES_PASSWORD=cambiame-password-largo-de-la-base
POSTGRES_DB=realestate

# Y esta el backend. El host es `postgres`, el nombre del servicio en el
# compose — no localhost: cada contenedor tiene su propio localhost.
# La contraseña tiene que coincidir con POSTGRES_PASSWORD.
DATABASE_URL=postgresql://app:cambiame-password-largo-de-la-base@postgres:5432/realestate?schema=public

# ── JWT ──────────────────────────────────────────────────────
# Dos secretos DISTINTOS, mínimo 32 caracteres. Generar cada uno con:
#   openssl rand -base64 48
# Rotarlos cierra todas las sesiones abiertas.
JWT_SECRET=cambiame-secreto-de-access-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiame-secreto-de-refresh-distinto-al-de-access
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage (MinIO en este mismo VPS) ────────────────────────
STORAGE_PROVIDER=s3

MINIO_ROOT_USER=inmobiliaria
MINIO_ROOT_PASSWORD=cambiame-password-largo-de-minio

# Endpoint interno: el backend firma las URLs hablando con el contenedor.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=inmobiliaria-media
# Tienen que coincidir con MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY_ID=inmobiliaria
S3_SECRET_ACCESS_KEY=cambiame-password-largo-de-minio

# Base pública desde donde el navegador lee las fotos. Es el host que Caddy
# expone apuntando a MinIO.
#
# OJO al cambiarlo después de tener fotos cargadas: la clave del objeto se
# deriva de la URL guardada, así que las viejas dejan de resolver y sus
# archivos quedan huérfanos. Migrar de dominio exige reescribir las url en la
# base.
S3_PUBLIC_URL=https://cdn.plataforma.com/inmobiliaria-media

S3_UPLOAD_URL_TTL_MIN=10
CLOUDINARY_URL=

# ── Email ────────────────────────────────────────────────────
# fake  → no manda nada, solo loguea. Sirve para arrancar sin cuenta de correo:
#         los leads se guardan igual, pero la inmobiliaria no se entera por mail.
# resend → envíos reales. Exige EMAIL_API_KEY y el dominio verificado con
#         SPF y DKIM, o los correos van a spam.
EMAIL_PROVIDER=fake
EMAIL_API_KEY=
EMAIL_FROM=Entre Rios Propiedades <no-reply@plataforma.com>

# ── Pagos ────────────────────────────────────────────────────
# fake        → cobros simulados, sin verificar firmas. Se puede lanzar así y
#               cargar las suscripciones a mano hasta tener la cuenta.
# mercadopago → cobros reales. Exige las dos claves de abajo.
#
# El webhook verifica la firma HMAC antes de mirar el cuerpo: sin
# PAYMENT_WEBHOOK_SECRET cualquiera que conozca la URL podría acreditarse un
# pago. Por eso el backend se niega a arrancar en mercadopago sin ella.
PAYMENT_PROVIDER=fake
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
