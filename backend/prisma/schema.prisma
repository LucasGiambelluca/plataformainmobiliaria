// Plataforma Inmobiliaria Multi-Tenant — schema v0.3
// Estrategia: shared database, shared schema, columna tenantId en toda tabla de negocio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────
enum BillingInterval {
  monthly
  yearly
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  suspended
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProviderName {
  mercadopago
  stripe
}

enum PaymentMode {
  sandbox
  production
}

enum UserRole {
  super_admin
  tenant_admin
  agent
}

enum PropertyType {
  apartment
  house
  land
  office
  warehouse
  commercial
}

enum OperationType {
  sale
  rent
  temporary_rental
}

enum PropertyStatus {
  draft
  published
  paused
  featured
}

enum MediaType {
  image
  video
}

enum MediaStatus {
  processing
  ready
  failed
}

enum InquiryStatus {
  new
  contacted
  closed
}

enum DomainStatus {
  pending
  verifying
  active
  failed
}

// ─────────────────────────────────────────────────────────────
// Negocio / billing
// ─────────────────────────────────────────────────────────────
model Plan {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String          @db.VarChar(100)
  slug                String          @unique @db.VarChar(50)
  priceAmount         Decimal         @map("price_amount") @db.Decimal(12, 2)
  priceCurrency       String          @default("ARS") @map("price_currency") @db.VarChar(3)
  billingInterval     BillingInterval @default(monthly) @map("billing_interval")
  maxProperties       Int             @map("max_properties")
  maxUsers            Int             @map("max_users")
  maxStorageMb        Int             @map("max_storage_mb")
  maxDomains          Int             @default(1) @map("max_domains")
  /// Habilita recibir solicitudes de tasación online. Es una capacidad, no un
  /// cupo: por eso es booleana y no un número como el resto.
  hasOnlineAppraisals Boolean         @default(false) @map("has_online_appraisals")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id                      String    @id @default(uuid()) @db.Uuid
  name                    String    @db.VarChar(255)
  slug                    String    @unique @db.VarChar(100)
  logoUrl                 String?   @map("logo_url")
  description             String?
  contactEmail            String?   @map("contact_email") @db.VarChar(255)
  contactPhone            String?   @map("contact_phone") @db.VarChar(50)
  isActive                Boolean   @default(true) @map("is_active")
  /// Última vez que el portal le asignó una tasación. Es lo que hace el turno
  /// rotativo: se elige a la que hace más tiempo que no recibe (null primero).
  lastAppraisalAssignedAt DateTime? @map("last_appraisal_assigned_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  users         User[]
  appraisals    Appraisal[]
  subscriptions Subscription[]
  payments      Payment[]
  properties    Property[]
  inquiries     Inquiry[]
  media         PropertyMedia[]
  domains       TenantDomain[]
  siteConfig    TenantSiteConfig?
  carousel      SiteCarouselImage[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  // Plan que el tenant intentó contratar y todavía no pagó. El cambio a planId
  // se aplica recién cuando la pasarela confirma: si se aplicara al abrir el
  // checkout, bastaría con abandonarlo para quedarse con el plan caro gratis.
  pendingPlanId      String?            @map("pending_plan_id") @db.Uuid
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  externalRef        String?            @map("external_ref")
  // Débito automático del checkout abierto y todavía no pagado. `externalRef`
  // es el débito VIGENTE. Van separados porque un cambio de plan tiene dos
  // débitos vivos a la vez hasta que el nuevo cobra: con una sola columna el
  // checkout pisaba la referencia del vigente, que quedaba debitando sin que
  // nadie pudiera cancelarlo.
  pendingExternalRef String?            @map("pending_external_ref")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@map("subscriptions")
}

model Payment {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @default("ARS") @db.VarChar(3)
  status         PaymentStatus       @default(pending)
  provider       PaymentProviderName
  /// Id del cobro en la pasarela. UNIQUE, y nullable a propósito: PostgreSQL
  /// admite varios NULL en un índice único, así que los pagos que todavía no
  /// pasaron por la pasarela conviven sin estorbarse.
  ///
  /// El chequeo previo del repositorio avisa temprano, pero no cierra la
  /// carrera: Mercado Pago reintenta el webhook sin esperar a que termine el
  /// anterior, así que dos entregas concurrentes pasan las dos el `findFirst`.
  /// Esta restricción es la que hace que solo una gane; la otra recibe un P2002
  /// y se trata como lo que es, la misma entrega de nuevo. Mismo criterio que
  /// `User.email`.
  externalPaymentId String?             @unique @map("external_payment_id")
  paidAt            DateTime?           @map("paid_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// Core / usuarios
// ─────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid // null solo para super_admin
  // Único global y no solo por tenant: el login resuelve por email sin saber
  // la inmobiliaria (auth.repository.findUserByEmail), así que dos filas con el
  // mismo email dejan a una persona sin poder entrar. El chequeo previo de los
  // servicios da el 409 lindo; esta restricción es la que cierra la carrera.
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         UserRole
  name         String?  @db.VarChar(255)
  phone        String?  @db.VarChar(50)
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdProperties Property[]     @relation("PropertyCreatedBy")
  refreshTokens     RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

// Refresh tokens persistidos (hash SHA-256, nunca el token en claro) para
// soportar rotación en /auth/refresh y revocación en /auth/logout (§8.1).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Contenido
// ─────────────────────────────────────────────────────────────
model Property {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  title         String         @db.VarChar(255)
  description   String?
  propertyType  PropertyType   @map("property_type")
  operationType OperationType  @map("operation_type")
  price         Decimal        @db.Decimal(15, 2)
  currency      String         @default("USD") @db.VarChar(3)
  address       String?
  city          String?        @db.VarChar(120)
  state         String?        @db.VarChar(120)
  country       String?        @db.VarChar(120)
  lat           Decimal?       @db.Decimal(10, 8)
  lng           Decimal?       @db.Decimal(11, 8)
  areaM2        Decimal?       @map("area_m2") @db.Decimal(12, 2)
  rooms         Int?
  bathrooms     Int?
  parking       Int?
  floor         Int?
  yearBuilt     Int?           @map("year_built")
  status        PropertyStatus @default(draft)
  viewsCount    Int            @default(0) @map("views_count")
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   User?             @relation("PropertyCreatedBy", fields: [createdBy], references: [id])
  media     PropertyMedia[]
  features  PropertyFeature[]
  inquiries Inquiry[]

  @@index([tenantId, status])
  @@index([status])
  @@map("properties")
}

model PropertyMedia {
  id           String      @id @default(uuid()) @db.Uuid
  propertyId   String      @map("property_id") @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid // desnormalizado para enforcement de storage
  type         MediaType
  url          String
  thumbnailUrl String?     @map("thumbnail_url")
  sizeBytes    BigInt      @map("size_bytes")
  durationSec  Int?        @map("duration_sec")
  sortOrder    Int         @default(0) @map("sort_order")
  isCover      Boolean     @default(false) @map("is_cover")
  status       MediaStatus @default(processing)
  createdAt    DateTime    @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_media")
}

model PropertyFeature {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  feature    String @db.VarChar(100)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_features")
}

model Inquiry {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  propertyId String?       @map("property_id") @db.Uuid
  name       String        @db.VarChar(255)
  email      String        @db.VarChar(255)
  phone      String?       @db.VarChar(50)
  message    String
  status     InquiryStatus @default(new)
  createdAt  DateTime      @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("inquiries")
}

// ─────────────────────────────────────────────────────────────
// Web propia + dominios (v0.3)
// ─────────────────────────────────────────────────────────────
model TenantDomain {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  domain            String       @unique @db.VarChar(253)
  status            DomainStatus @default(pending)
  verificationToken String?      @map("verification_token")
  dnsTarget         String?      @map("dns_target") @db.VarChar(253)
  lastCheckedAt     DateTime?    @map("last_checked_at")
  verifiedAt        DateTime?    @map("verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("tenant_domains")
}

model TenantSiteConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  primaryColor     String?  @map("primary_color") @db.VarChar(7)
  secondaryColor   String?  @map("secondary_color") @db.VarChar(7)
  heroTitle        String?  @map("hero_title")
  heroSubtitle     String?  @map("hero_subtitle")
  aboutText        String?  @map("about_text")
  socialFacebook   String?  @map("social_facebook")
  socialInstagram  String?  @map("social_instagram")
  socialWhatsapp   String?  @map("social_whatsapp")
  showFeaturedOnly Boolean  @default(false) @map("show_featured_only")
  template         String?  @default("default") @db.VarChar(50)
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carousel SiteCarouselImage[]

  @@map("tenant_site_config")
}

model SiteCarouselImage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  siteConfigId String   @map("site_config_id") @db.Uuid
  imageUrl     String   @map("image_url")
  linkUrl      String?  @map("link_url")
  caption      String?  @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteConfig TenantSiteConfig @relation(fields: [siteConfigId], references: [id], onDelete: Cascade)

  @@index([tenantId, sortOrder])
  @@map("site_carousel_images")
}

// ─────────────────────────────────────────────────────────────
// Auditoría
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid // null para acciones globales de super_admin
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Índices públicos de las calculadoras
//
// Caché local de series que publican el BCRA (ICL) y el INDEC (IPC). Son
// datos públicos nacionales, no de una inmobiliaria: son las únicas tablas
// de negocio sin tenant_id, y por eso su repositorio NO extiende
// BaseRepository. No hay nada que aislar porque no hay dueño.
//
// Existen para que la calculadora siga andando cuando el organismo está
// caído, y para no pegarle a una API ajena en cada cálculo.
// ─────────────────────────────────────────────────────────────
model IndexValue {
  serie String   @db.VarChar(10) // "icl" | "ipc"
  fecha DateTime @db.Date
  valor Decimal  @db.Decimal(18, 6)

  @@id([serie, fecha])
  @@map("index_values")
}

model IndexSync {
  serie          String   @id @db.VarChar(10)
  // Fecha del dato más nuevo que trajo la última sincronización.
  ultimoDato     DateTime @map("ultimo_dato") @db.Date
  // Cuándo se sincronizó. Alimenta el TTL y el aviso de "actualizado al ...".
  sincronizadoEn DateTime @map("sincronizado_en")

  @@map("index_syncs")
}

// ─────────────────────────────────────────────────────────────
// Tasaciones online
//
// El propietario de un inmueble pide una estimación desde el portal, sin
// cuenta. La solicitud nace SIN dueño y se asigna a una inmobiliaria: por eso
// `tenant_id` es nullable, a diferencia del resto de las tablas de negocio.
// El aislamiento sigue existiendo (la bandeja filtra por { id, tenantId });
// lo que cambia es que hay un estado previo a tener tenant.
//
// Solo reciben solicitudes las inmobiliarias con un plan que las habilite
// (Plan.hasOnlineAppraisals).
// ─────────────────────────────────────────────────────────────
enum AppraisalStatus {
  unassigned // ninguna inmobiliaria participante en esa localidad
  new
  contacted
  completed
  discarded
}

// Más amplio que PropertyType: una tasación cubre inmuebles que el catálogo
// no publica (quinta, chacra, campo) y admite "otro".
enum AppraisalPropertyType {
  house
  apartment
  ph
  duplex
  commercial
  office
  warehouse
  land
  farm
  country_house
  ranch
  other
}

enum AppraisalPurpose {
  sale
  rent
  sale_and_rent
  other
}

enum AppraisalCondition {
  excellent
  very_good
  good
  fair
  to_renovate
}

model Appraisal {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  // Solicitante. No es usuario de la plataforma: son datos de un tercero.
  name  String @db.VarChar(255)
  phone String @db.VarChar(50)
  email String @db.VarChar(255)

  // Propiedad
  city         String                @db.VarChar(120)
  neighborhood String?               @db.VarChar(120)
  address      String                @db.VarChar(255)
  propertyType AppraisalPropertyType @map("property_type")
  purpose      AppraisalPurpose

  // Características básicas
  areaM2    Decimal?            @map("area_m2") @db.Decimal(10, 2)
  rooms     Int?
  bathrooms Int?
  condition AppraisalCondition?
  comments  String?

  // Los siete bloques desplegables (ambientes, servicios, comodidades,
  // situación, valor estimado, motivo, plazo). Van en Json porque nadie filtra
  // por "tiene parrilla": se leen enteros al abrir la ficha. Se validan con
  // Zod al entrar, así que la forma está garantizada aunque la base no la
  // imponga.
  details Json?

  status                AppraisalStatus @default(new)
  /// true si la eligió el portal, false si la eligió el propietario.
  assignedAutomatically Boolean         @default(false) @map("assigned_automatically")
  assignedAt            DateTime?       @map("assigned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  media  AppraisalMedia[]

  @@index([tenantId, status])
  @@index([status])
  @@map("appraisals")
}

// Fotos que sube el propietario antes de que exista la solicitud.
//
// No reusa PropertyMedia: aquello exige propertyId y tenantId y descuenta del
// cupo de storage del plan. Acá quien sube es un anónimo y todavía no hay
// inmobiliaria, así que no puede descontarle a nadie. El control es por
// cantidad y tamaño por solicitud, no por cupo.
model AppraisalMedia {
  id          String    @id @default(uuid()) @db.Uuid
  /// Agrupa las fotos antes de que la solicitud exista. Lo emite el servidor.
  draftId     String    @map("draft_id") @db.Uuid
  appraisalId String?   @map("appraisal_id") @db.Uuid
  url         String
  sizeBytes   BigInt    @map("size_bytes")
  /// pending hasta que se confirma contra el tamaño real del objeto.
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  appraisal Appraisal? @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([appraisalId])
  @@map("appraisal_media")
}

/// Credenciales de la pasarela, cargadas desde el panel del super admin.
///
/// Fila única (id fijo): la plataforma cobra con una sola cuenta de
/// MercadoPago, así que no hay tenant_id acá. Los dos juegos van como columnas
/// de la misma fila y no como dos filas con un isActive, para que "cuál está
/// activa" sea un dato y no un invariante que alguien tenga que sostener.
///
/// Los cuatro secretos se guardan cifrados: ver shared/services/crypto/secretBox.
model PaymentSettings {
  id                      String      @id @default("singleton")
  activeMode              PaymentMode @default(sandbox) @map("active_mode")

  sandboxAccessToken      String?     @map("sandbox_access_token")
  sandboxWebhookSecret    String?     @map("sandbox_webhook_secret")
  productionAccessToken   String?     @map("production_access_token")
  productionWebhookSecret String?     @map("production_webhook_secret")

  updatedAt               DateTime    @updatedAt @map("updated_at")
  updatedById             String?     @map("updated_by_id")

  @@map("payment_settings")
}
