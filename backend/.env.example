# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug

# ── Multitenancy / dominios ──────────────────────────
PLATFORM_DOMAIN=plataforma.com
CUSTOM_DOMAIN_TARGET=plataforma.com

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://app:devpassword@localhost:5432/realestate?schema=public

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-dev-access-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage ──────────────────────────────────────────
# s3    → S3-compatible (MinIO en el VPS, o S3/R2). Exige las S3_* de abajo.
# fake  → no sube nada; el backend arranca igual. Solo dev/tests.
STORAGE_PROVIDER=s3

# Valores para el MinIO del docker-compose. En el VPS, S3_PUBLIC_URL es el
# dominio que Caddy expone apuntando a MinIO (ej. https://cdn.plataforma.com).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=inmobiliaria-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=devminiopassword
S3_PUBLIC_URL=http://localhost:9000/inmobiliaria-media
S3_UPLOAD_URL_TTL_MIN=10

CLOUDINARY_URL=

# ── Email (cliente) ──────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=no-reply@plataforma.com

# ── Pago ─────────────────────────────────────────────
# mercadopago → cobros reales. Exige las dos claves de abajo.
# fake        → cobros simulados, sin verificar firmas. Solo desarrollo.
PAYMENT_PROVIDER=fake

# Access token del vendedor (Credenciales de producción en el panel de MP).
PAYMENT_API_KEY=
# Clave secreta de la notificación webhook (MP > Webhooks > Configurar).
# Sin esto no se puede verificar la firma y cualquiera podría acreditarse pagos.
PAYMENT_WEBHOOK_SECRET=

# URL pública del backend: MercadoPago la usa como notification_url, así que
# en producción no puede ser localhost.
BACKEND_URL=http://localhost:3000
