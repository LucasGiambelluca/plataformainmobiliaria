# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug

# ── Multitenancy / dominios ──────────────────────────
PLATFORM_DOMAIN=plataforma.com
CUSTOM_DOMAIN_TARGET=plataforma.com

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://app:devpassword@localhost:5432/realestate?schema=public

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-dev-access-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage (cliente) ────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=

# ── Email (cliente) ──────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=no-reply@plataforma.com

# ── Pago (cliente) ───────────────────────────────────
PAYMENT_PROVIDER=mercadopago
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
