# M2Props — credenciales de MinIO. Copiar a /etc/m2props/minio.env, poner las
# claves y dejar root:m2props 640. systemd lo lee, no el repo.
#
#   install -m 640 -o root -g m2props minio.env.example /etc/m2props/minio.env
#
# Son las mismas claves que van en S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY del
# backend: MinIO valida la firma de las URLs de subida con ellas, así que si no
# coinciden toda subida falla con SignatureDoesNotMatch.
#
# La consola de administración escucha en 127.0.0.1:9001. Para verla:
#   ssh -L 9001:127.0.0.1:9001 root@VPS

# openssl rand -base64 24
MINIO_ROOT_USER=m2props
MINIO_ROOT_PASSWORD=CAMBIAR
