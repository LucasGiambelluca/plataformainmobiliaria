# M2Props — configuración del backend. Copiar a /etc/m2props/backend.env, poner
# los secretos y dejar root:root 600. systemd lo lee, no el repo.
#
#   install -m 600 -o root -g root env.example /etc/m2props/backend.env

NODE_ENV=production

# 3010 y no 3000: el 3000 lo tiene el Next.js del "desplegador", que vive en el
# mismo VPS. Loopback, para que el único que llegue sea el nginx local.
PORT=3010
HOST=127.0.0.1

# El origen real de la web. El backend solo acepta credenciales desde acá, y es
# lo que usa como fallback para armar URL absolutas.
FRONTEND_URL=https://hernandezyasociados.com.ar
BACKEND_URL=https://hernandezyasociados.com.ar/m2prop

# La app vive bajo este prefijo. NO es decorativo: con él se arma el `path` de la
# cookie de refresh, el prefijo del sitemap y las reglas de robots.txt. Si queda
# vacío, la sesión se cae en cada recarga aunque el login haya sido correcto.
APP_BASE_PATH=/m2prop

# El dominio del apex. Es lo que decide, en el navegador y en el backend, si un
# host es el portal o la web de una inmobiliaria: cualquier host que no sea este
# (ni su www, ni un subdominio reservado) se trata como web de inmobiliaria.
PLATFORM_DOMAIN=hernandezyasociados.com.ar
CUSTOM_DOMAIN_TARGET=hernandezyasociados.com.ar

# "fake" no consulta el DNS real. En este despliegue los dominios propios de las
# inmobiliarias no pueden funcionar (el TLS lo maneja nginx, no hay on-demand),
# así que verificar nameserver contra la nada solo produce falsos negativos.
DNS_RESOLVER=fake

# ── Base de datos ────────────────────────────────────────────
# El Postgres del host, base y rol propios: comparte el clúster con el
# "desplegador" pero no puede tocar sus datos.
DATABASE_URL=postgresql://m2props_app:CAMBIAR@127.0.0.1:5432/m2props?schema=public

# ── Secretos ─────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR
JWT_REFRESH_SECRET=CAMBIAR

# ── Multimedia ───────────────────────────────────────────────
STORAGE_PROVIDER=s3
S3_REGION=us-east-1
S3_BUCKET=inmobiliaria-media
S3_ACCESS_KEY_ID=CAMBIAR
S3_SECRET_ACCESS_KEY=CAMBIAR

# OJO, estas dos van juntas y ninguna de las dos lleva el prefijo de la app.
#
# S3_ENDPOINT es contra lo que se FIRMA la URL de subida, así que tiene que ser
# el origen público pelado. Si se pone 127.0.0.1:9000, la firma queda sobre un
# host que el navegador nunca va a usar y toda subida falla con
# SignatureDoesNotMatch. Y si se le agrega /m2prop, la ruta firmada queda
# /m2prop/inmobiliaria-media/<clave> y MinIO toma "m2prop" como nombre de
# bucket: S3 con direccionamiento por path exige que el primer segmento de la
# ruta sea el bucket, así que la multimedia no puede vivir bajo un prefijo.
# Verificado contra el despliegue.
#
# S3_PUBLIC_URL es contra lo que el navegador LEE. El nombre del bucket es el
# primer segmento de la ruta, y por eso el nginx de /inmobiliaria-media/ no
# puede reescribir el path.
S3_ENDPOINT=https://hernandezyasociados.com.ar
S3_PUBLIC_URL=https://hernandezyasociados.com.ar/inmobiliaria-media
S3_UPLOAD_URL_TTL_MIN=10

# ── Servicios externos ───────────────────────────────────────
# Arranca con los tres en "fake" a propósito: así la plataforma se levanta y se
# puede recorrer sin ningún alta. Para cobrar de verdad hay que pasar a resend y
# mercadopago (ver docs/deploy.md, sección 10).
EMAIL_PROVIDER=fake
# Con comillas: el < > de la dirección es una redirección para bash, y este
# archivo lo sourcinga update.sh además de leerlo systemd.
EMAIL_FROM="M2Prop <no-reply@hernandezyasociados.com.ar>"

PAYMENT_PROVIDER=fake
# 32 bytes en hex. NO cambia nunca más: es lo que permite rotar el access token
# de MercadoPago sin deploy. Generar con: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=CAMBIAR

# ── Índices de las calculadoras ──────────────────────────────
# "oficial" baja las series al BCRA y a datos.gob.ar. "fake" inventa los números,
# que sirve para probar la pantalla pero no para mostrar un ajuste real.
INDEX_PROVIDER=oficial
INDEX_TTL_HORAS=12

LOG_LEVEL=info
