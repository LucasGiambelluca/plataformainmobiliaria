# ─────────────────────────────────────────────────────────────
# Caddy del borde. Único servicio expuesto a internet.
#
# Resuelve tres tipos de host:
#   plataforma.com            → el portal
#   demo.plataforma.com       → la web de una inmobiliaria, por subdominio
#   inmobiliarianorte.com.ar  → la web de una inmobiliaria, dominio propio
#
# Los dos últimos caen en el bloque :443 con On-Demand TLS, que emite el
# certificado en la primera visita. Ver el comentario de on_demand_tls.
# ─────────────────────────────────────────────────────────────

{
	# Let's Encrypt avisa a esta dirección si un certificado está por vencer y
	# no se pudo renovar.
	email {$ACME_EMAIL}

	# ¡SEGURIDAD! Sin `ask`, Caddy intentaría emitir un certificado para
	# CUALQUIER dominio que alguien apunte a la IP de este VPS. Eso permite que
	# un tercero agote la cuota de emisión de Let's Encrypt (50 certificados
	# por semana) y deje a las inmobiliarias reales sin poder renovar.
	#
	# `ask` le pregunta al backend, antes de emitir, si ese host pertenece a
	# alguna inmobiliaria. El backend responde 200 para autorizar y 403 para
	# rechazar. El contrato completo está en docs/deploy.md.
	on_demand_tls {
		ask http://backend:3000/api/internal/caddy/ask?token={$CADDY_ASK_TOKEN}
		interval 2m
		burst 5
	}
}

# Config común a todo host que sirva la aplicación.
(app) {
	encode gzip zstd

	# La API va por el MISMO host que la web, no por api.plataforma.com.
	#
	# Es la decisión que hace funcionar los dominios propios: si la API viviera
	# en otro host, la web de inmobiliarianorte.com.ar la llamaría cross-origin
	# y la cookie httpOnly del refresh (sameSite lax) no viajaría — la sesión se
	# caería en cada recarga. Sirviendo todo desde el mismo origen no hay CORS
	# ni cookies de terceros.
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /health {
		reverse_proxy backend:3000
	}

	# Los arma el backend con datos reales y dependen del host: en el portal
	# listan todo, en el dominio de una inmobiliaria solo lo suyo. Van antes del
	# handle de los estáticos, que si no devolvería el index.html de la SPA.
	handle /sitemap.xml {
		reverse_proxy backend:3000
	}

	handle /robots.txt {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		# Sin includeSubDomains: en un dominio propio, los otros subdominios son
		# del cliente y pueden no tener HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# ── Portal de la plataforma ──────────────────────────────────
{$PLATFORM_DOMAIN}, www.{$PLATFORM_DOMAIN} {
	import app
}

# ── Multimedia (MinIO) ───────────────────────────────────────
# El bucket es de lectura pública: las fotos de las propiedades se publican en
# catálogos abiertos. La escritura sigue exigiendo URL firmada, así que este
# proxy no expone nada que no sea ya público.
#
# Este host tiene bloque propio para que su certificado se emita por HTTP-01 al
# arrancar, sin depender del On-Demand TLS.
cdn.{$PLATFORM_DOMAIN} {
	reverse_proxy minio:9000

	header {
		Cache-Control "public, max-age=604800"
		X-Content-Type-Options nosniff
	}
}

# ── Webs de las inmobiliarias ────────────────────────────────
# Todo lo que no matcheó arriba: subdominios *.plataforma.com y dominios
# propios. El certificado se emite en la primera visita, previa autorización
# del backend (ver on_demand_tls).
#
# Un host no autorizado no recibe certificado y el handshake TLS falla: es la
# respuesta correcta para un dominio que no es de nadie en la plataforma.
:443 {
	tls {
		on_demand
	}
	import app
}
