# Servidor de estáticos de la SPA. No termina TLS ni habla con nadie de afuera:
# el Caddy del borde es el único expuesto a internet.
:80 {
	root * /srv
	encode gzip zstd

	# React Router maneja las rutas del lado del cliente. Sin esto, entrar
	# directo a /panel/propiedades o recargar con F5 devuelve 404.
	try_files {path} /index.html
	file_server

	# Los assets llevan hash en el nombre: si el contenido cambia, cambia la
	# URL. Se pueden cachear para siempre sin riesgo de servir uno viejo.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# index.html no se cachea: es el archivo que apunta a los assets nuevos
	# después de cada deploy. Cachearlo deja a la gente en la versión anterior.
	header /index.html Cache-Control "no-cache"
}
