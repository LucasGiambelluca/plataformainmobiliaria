# URL base de la API. Debe coincidir con el puerto del backend + el prefijo /api.
# El backend acepta credenciales solo desde su FRONTEND_URL (ver backend/.env).
VITE_API_URL=http://localhost:3000/api

# Dominio del portal. Todo host que no sea este (ni su www, ni un subdominio
# reservado) se sirve como la web de una inmobiliaria: la raíz muestra su sitio
# en vez de la home del portal.
#
# En desarrollo se deja vacío: se entra por localhost y la web de una
# inmobiliaria se ve en /inmobiliaria/:slug. En producción tiene que valer lo
# mismo que el PLATFORM_DOMAIN del backend.
VITE_PLATFORM_DOMAIN=
